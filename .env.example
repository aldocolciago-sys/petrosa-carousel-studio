# Copia questo file in ".env" e compila i valori.

# Chiave API Anthropic (console.anthropic.com) - serve per far scrivere i caroselli a Claude
ANTHROPIC_API_KEY=
# Facoltativo: modello da usare
# ANTHROPIC_MODEL=claude-sonnet-4-5

# Chiave API PostFast (PostFast > Settings > API) - pubblica su Instagram e TikTok
POSTFAST_API_KEY=

# Porta locale dell'app
# PORT=3000

# Facoltativo: password (HTTP Basic, nome utente qualsiasi) per proteggere l'app. Su Vercel abilita anche le funzioni con chiavi segrete.
# APP_PASSWORD=

# Login con Google (facoltativo in locale, consigliato online). Se impostati, l'app e' accessibile solo alle email autorizzate.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Email autorizzate, separate da virgola (default: aldo.colciago@gmail.com,petrosaband@gmail.com)
# ALLOWED_EMAILS=aldo.colciago@gmail.com,petrosaband@gmail.com
# Indirizzo pubblico del sito, se serve fissarlo (es. https://petrosa-carousel-studio.vercel.app)
# APP_URL=
